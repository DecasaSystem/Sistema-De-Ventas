# Vercel CLI — contiene VERCEL_OIDC_TOKEN y credenciales del proyecto.
# Se crea al ejecutar `vercel --prod` desde la raiz del repo.
.vercel/

# Scripts locales de diagnostico contra la base de datos.
# Llevan credenciales de produccion en texto plano: nunca deben subirse.
dbcheck.mjs
decasa-app/dbcheck.mjs

# Cache de fuentes que DomPDF genera al crear un PDF. Se regenera solo.
decasa-api/storage/fonts/

# Skills de agentes: el contenido va en .agents/ (con skills-lock.json, que
# fija sus versiones). .claude/skills/ son accesos directos a esas carpetas
# con la ruta de cada computador; el instalador los crea en cada máquina.
.claude/skills/
# Comprimido que trae una skill de ejemplo; no hace falta en el repo.
.agents/skills/deploy-to-vercel/Archive.zip

# Mapa de código generado por graphify (graphify update .): se regenera, no se versiona
graphify-out/
