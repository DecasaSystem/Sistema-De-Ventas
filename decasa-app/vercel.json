{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://decasa-api-b91v.onrender.com/api/$1" },
    { "source": "/storage/(.*)", "destination": "https://decasa-api-b91v.onrender.com/storage/$1" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
